{
  "name": "@acme/apphost",
  "version": "26.11.0",
  "private": true,
  "scripts": {
    "build": "dotnet build Acme.AppHost -c Release",
    "typecheck": "dotnet build Acme.AppHost -c Debug",
    "lint": "dotnet build Acme.AppHost -c Debug -warnaserror",
    "format": "dotnet format whitespace . --folder --verify-no-changes"
  },
  "nx": {
    "targets": {
      "build": {
        "parallelism": false
      },
      "typecheck": {
        "parallelism": false
      },
      "lint": {
        "parallelism": false
      }
    }
  }
}
