{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity-api",
        "Match": {"Path": "/api/identity/{**catch-all}"},
        "Transforms": [{"PathRemovePrefix": "/api/identity"}]
      },
      "dealership": {
        "ClusterId": "dealership-api",
        "Match": {"Path": "/api/dealership/{**catch-all}"},
        "Transforms": [{"PathRemovePrefix": "/api/dealership"}]
      },
      "documents": {
        "ClusterId": "document-api",
        "Match": {"Path": "/api/documents/{**catch-all}"},
        "Transforms": [{"PathRemovePrefix": "/api/documents"}]
      }
    },
    "Clusters": {
      "identity-api": {"Destinations": {"default": {"Address": "http://identity-api"}}},
      "dealership-api": {"Destinations": {"default": {"Address": "http://dealership-api"}}},
      "document-api": {"Destinations": {"default": {"Address": "http://document-api"}}}
    }
  }
}
