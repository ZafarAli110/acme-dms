{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity-api",
        "Match": { "Path": "/api/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/identity" }]
      },
      "dealership": {
        "ClusterId": "dealership-api",
        "Match": { "Path": "/api/dealership/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/dealership" }]
      },
      "documents": {
        "ClusterId": "document-api",
        "Match": { "Path": "/api/documents/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/documents" }]
      }
    },
    "Clusters": {
      "identity-api": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/v1/system/alive"
          },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": { "default": { "Address": "http://identity-api" } }
      },
      "dealership-api": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/v1/system/alive"
          },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": { "default": { "Address": "http://dealership-api" } }
      },
      "document-api": {
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:05",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/v1/system/alive"
          },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "1" },
        "Destinations": { "default": { "Address": "http://document-api" } }
      }
    }
  }
}
