{
  "name": "@acme/gateway-api",
  "version": "26.11.0",
  "private": true,
  "scripts": {
    "build": "dotnet build Acme.Gateway.slnx -c Release",
    "typecheck": "dotnet build Acme.Gateway.slnx -c Debug",
    "lint": "dotnet build Acme.Gateway.slnx -c Debug -warnaserror",
    "format": "dotnet format whitespace . --folder --verify-no-changes",
    "test": "dotnet test --solution Acme.Gateway.slnx",
    "dev": "dotnet run --project src/Acme.Gateway"
  },
  "nx": {
    "targets": {
      "build": {
        "parallelism": false
      },
      "typecheck": {
        "parallelism": false
      },
      "lint": {
        "parallelism": false
      },
      "format": {
        "parallelism": false
      },
      "test": {
        "parallelism": false
      }
    }
  }
}
