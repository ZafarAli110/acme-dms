{
  "name": "@acme/dealership-api",
  "version": "26.11.0",
  "private": true,
  "type": "module",
  "imports": {
    "#service/*": "./src/service/*.ts",
    "#business-logic/*": "./src/business-logic/*.ts",
    "#business-logic-abstractions/*": "./src/business-logic-abstractions/*.ts",
    "#dto/*": "./src/dto/*.ts",
    "#i18n/*": "./src/i18n/*.ts",
    "#request-scope/*": "./src/request-scope/*.ts",
    "#persistence/*": "./src/persistence/*.ts",
    "#rest-clients/*": "./src/rest-clients/*.ts",
    "#settings/*": "./src/settings/*.ts",
    "#test-setup/*": "./src/test-setup/*.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "node --env-file-if-exists=.env --enable-source-maps --import ./dist/observability/telemetry.js dist/main.js",
    "dev": "bun scripts/dev.ts",
    "worker": "bun scripts/dev.ts worker",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint -c .oxlintrc.json src && oxlint scripts",
    "format": "bun fmt --check src scripts",
    "test": "vitest run",
    "generate:clients": "bun scripts/generate-rest-clients.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "replay:dead-letters": "bun scripts/replay-dead-letters.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/http-client": "0.0.3",
    "@nestjs/i18n": "0.0.3",
    "@nestjs/platform-node": "12.4.0",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/swagger": "12.1.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-pino": "0.70.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "amqplib": "2.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "import-in-the-middle": "3.5.3",
    "jose": "6.2.14",
    "nestjs-pino": "5.3.1",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "pg-query-stream": "4.10.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.6",
    "valibot": "1.5.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@opentelemetry/instrumentation-amqplib": "0.71.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "@types/yazl": "2.4.6",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "1.0.0-rc.5",
    "testcontainers": "12.2.1",
    "vitest": "5.0.5"
  }
}
