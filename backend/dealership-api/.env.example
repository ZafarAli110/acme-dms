# dealership-api's own settings, for your machine. Copy to .env (git ignores it) and change what you need; node reads
# it at start (--env-file-if-exists). A variable set by Aspire or your shell wins over this file. Defaults are in
# src/settings/settings.ts. Aspire sets the connection strings and service addresses: do not put them here.

# How long a request may take before it is answered 504 and its calls to other services stop.
REQUEST_TIMEOUT=30s

# How long one SQL statement may run before Postgres cancels it.
DATABASE_STATEMENT_TIMEOUT=30s

# Connections this instance keeps to the database, and how long a request waits for a free one.
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT=10s

# pino's level: trace, debug, info, warn, error.
LOG_LEVEL=info
