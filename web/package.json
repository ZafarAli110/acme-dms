{
  "name": "@acme/web",
  "version": "26.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "oxlint app e2e",
    "format": "bun fmt --check app e2e",
    "e2e": "NODE_EXTRA_CA_CERTS=../.certs/localhost.pem playwright test -c e2e/playwright.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-data-grid": "9.17.0",
    "@tanstack/react-query": "5.105.1",
    "i18next": "26.6.0",
    "i18next-browser-languagedetector": "8.2.4",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.10",
    "react-router": "8.5.1",
    "temporal-polyfill": "1.0.6",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
