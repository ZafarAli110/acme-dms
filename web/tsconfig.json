{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2025", "ESNext.Disposable", "ESNext.Error", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", ".react-router/types/**/*", "vite.config.ts", "react-router.config.ts"]
}
