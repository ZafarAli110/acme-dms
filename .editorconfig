root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
# Handler folders are named for the action (Handlers/Documents/Get/), so namespaces may be words like Get that VB
# reserves. Nothing here is consumed from VB; CA1716 still checks types, members and parameters.
dotnet_code_quality.CA1716.analyzed_symbol_kinds = NamedType, Method, Property, Event, Parameter

# Private fields, static or not, are _camelCase (_unitOfWork, _jsonOptions): one look tells a field from a local.
# Constants stay PascalCase. The build reports a wrong name (IDE1006) and lint fails on it.
dotnet_diagnostic.IDE1006.severity = warning
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated: analyzers and the formatter leave them alone.
[**/Migrations/*.cs]
generated_code = true

# Test names follow IDS: MethodUnderTest_Behaviour (ExecuteAsync_RejectsAWrongPassword).
[**/tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
