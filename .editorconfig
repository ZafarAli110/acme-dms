root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
# Handler folders are named for the action (Handlers/Documents/Get/), so namespaces may be words like Get that VB
# reserves. Nothing here is consumed from VB; CA1716 still checks types, members and parameters.
dotnet_code_quality.CA1716.analyzed_symbol_kinds = NamedType, Method, Property, Event, Parameter

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated: analyzers and the formatter leave them alone.
[**/Migrations/*.cs]
generated_code = true

# Test names follow IDS: MethodUnderTest_Behaviour (ExecuteAsync_RejectsAWrongPassword).
[**/tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
