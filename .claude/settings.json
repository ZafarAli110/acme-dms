{
  "permissions": {
    "allow": [
      "Bash(bun run gate:fast)",
      "Bash(bun run test)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bunx nx *)",
      "Bash(bun run api as *)",
      "Bash(bun run sql:explain *)",
      "Bash(bun run status)",
      "Bash(bun run logs *)",
      "Bash(bun run traces *)",
      "Bash(bun run errors)",
      "Bash(bun run start)",
      "Bash(bun run stop)",
      "Bash(bun run rebuild *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "mcp__acme-tracker__list_tickets",
      "mcp__acme-tracker__get_ticket",
      "Bash(bunx playwright-cli *)",
      "mcp__acme-tracker__create_ticket",
      "Bash(bun run xlsx:inspect *)",
      "Bash(git switch -c ACME-*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin ACME-*)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh api -X PATCH *issues/comments/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(git fetch origin *)",
      "Bash(git worktree add --detach *)",
      "Bash(git worktree remove *)",
      "Bash(git rev-parse *)",
      "mcp__acme-tracker__update_ticket_status",
      "mcp__acme-tracker__add_comment",
      "mcp__acme-tracker__attach_file"
    ],
    "ask": [
      "Bash(bun run reset)",
      "Bash(bun run resource *)",
      "Bash(bun run seed)",
      "Bash(bun add *)",
      "Bash(bun install *)",
      "Bash(dotnet add *)",
      "Bash(dotnet ef *)",
      "Bash(git checkout *)",
      "WebFetch",
      "WebSearch",
      "Edit(.claude/skills/**)",
      "Edit(.claude/agents/**)",
      "Bash(bun run seed:bulk*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin lab/*)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(aspire *)",
      "Bash(bun run dev)",
      "Bash(podman *)",
      "Bash(docker *)",
      "Bash(psql *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.ts\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/ticket-branch.ts\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.ts\""
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-plan.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.ts\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/open-plans.ts\""
          }
        ]
      }
    ]
  }
}
