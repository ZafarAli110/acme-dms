{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{"type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.ts\""}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{"type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.ts\""}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate.ts\"", "timeout": 600}]
      }
    ]
  }
}
