<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: user-level sources (e.g. the internal Azure feed) would trip NU1507 under central package management. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
