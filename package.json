{
  "name": "acme-dms",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "backend/*",
    "web",
    "apphost"
  ],
  "scripts": {
    "dev": "aspire run",
    "status": "aspire describe",
    "logs": "aspire logs",
    "traces": "aspire otel traces",
    "errors": "aspire otel traces --has-error true",
    "api": "bun scripts/api.ts",
    "seed": "bun scripts/seed.ts",
    "seed:bulk": "bun scripts/seed-bulk.ts",
    "reset": "bun scripts/reset.ts",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "lint": "nx run-many -t lint && oxlint scripts",
    "typecheck": "nx run-many -t typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "nx run-many -t test",
    "gate:fast": "nx affected -t format lint typecheck test",
    "gate:slow": "nx run @acme/web:e2e"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "nx": "24.0.2",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  }
}
