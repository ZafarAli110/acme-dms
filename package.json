{
  "name": "acme-dms",
  "version": "26.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.0.0",
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "backend/*",
    "web",
    "apphost"
  ],
  "scripts": {
    "dev": "bun scripts/check-node.ts && bun scripts/check-install.ts && aspire run",
    "start": "bun scripts/check-node.ts && bun scripts/check-install.ts && aspire start",
    "stop": "aspire stop",
    "rebuild": "bun scripts/rebuild.ts",
    "resource": "aspire resource",
    "hooks": "git config core.hooksPath .githooks",
    "status": "aspire describe",
    "logs": "aspire logs",
    "health": "bun scripts/health.ts",
    "traces": "aspire otel traces",
    "errors": "aspire otel traces --has-error true",
    "api": "bun scripts/api.ts",
    "sql:explain": "bun scripts/explain.ts",
    "seed": "bun scripts/seed.ts",
    "seed:bulk": "bun scripts/seed-bulk.ts",
    "xlsx:inspect": "bun scripts/inspect-xlsx.ts",
    "reset": "bun scripts/reset.ts",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "lint": "nx run-many -t lint && oxlint scripts",
    "typecheck": "nx run-many -t typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "test": "nx run-many -t test && bun test scripts ./.claude/hooks/check-plan.test.ts",
    "coverage": "bun scripts/coverage.ts",
    "docs:check": "bun scripts/check-docs.ts",
    "audit": "bun scripts/audit-sessions.ts",
    "load-test": "bun scripts/load-test.ts",
    "gate:fast": "bun scripts/gate.ts",
    "gate:slow": "nx run @acme/web:e2e"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "nx": "24.0.3",
    "oxlint": "1.90.0",
    "typescript": "7.0.2"
  }
}
